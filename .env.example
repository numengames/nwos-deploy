# DEV-01: every variable the code reads, no real values. Synced with
# src/lib/env.ts — production values are wrangler secrets
# (`npx wrangler secret put <KEY>`); local dev reads .env, `wrangler dev`
# reads .dev.vars.

# GitHub — workspace creation from the template and reads of generated repos
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_TEMPLATE_REPO=

# Anthropic — canon document generation in /api/registro
ANTHROPIC_API_KEY=

# Stripe restricted key, Checkout Sessions: read only — checks the paid trial
# before /api/registro calls the model (OPS-015). An Oracle sets it.
STRIPE_RESTRICTED_KEY=

# HMAC secret behind the per-workspace viewer access keys (src/lib/token.ts).
# REQUIRED and separate from GITHUB_TOKEN: without it /api/registro and
# /api/workspace/* answer "Missing configuration: WORKSPACE_KEY_SECRET".
# Generate one with `openssl rand -hex 32`. Rotating it voids every key issued.
WORKSPACE_KEY_SECRET=
