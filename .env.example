# GitHub — creación de workspaces desde template y lectura de repos generados
# Org actual: numen-games-nwos-orgs · template: nwos-workspace-template
# (renombrado desde nwos-template; el redirect de GitHub no cubre de forma
# fiable POST /repos/{owner}/{repo}/generate — usa siempre el nombre nuevo)
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_TEMPLATE_REPO=nwos-workspace-template

# Anthropic — generación de documentos canon en /api/registro
ANTHROPIC_API_KEY=

# Opcional — secreto para firmar las claves de acceso de los workspaces
# (/workspace/[slug]?key=...). Si falta, se deriva del GITHUB_TOKEN.
WORKSPACE_KEY_SECRET=
