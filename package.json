{
  "name": "nwos-deploy",
  "license": "AGPL-3.0-only",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/design-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/design-tokens.mjs && node scripts/share-card.mjs",
    "build": "astro build",
    "postbuild": "node scripts/license-check.mjs && node scripts/legal-check.mjs",
    "license-check": "node scripts/license-check.mjs",
    "type-check": "astro check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "wrangler dev --upstream-protocol https",
    "astro": "astro",
    "design-tokens": "node scripts/design-tokens.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.0",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@numengames/design-kit": "https://github.com/numengames/numinia-archive/releases/download/design-kit-v6.0.0/numengames-design-kit-6.0.0.tgz",
    "@tailwindcss/vite": "^4.2.5",
    "astro": "^7.3.5",
    "octokit": "^5.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.2.5",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.147.0"
  }
