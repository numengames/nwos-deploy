---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
import { socialLinks } from "@/data/social-links";
---

<footer class="border-t border-border">
	<div class="mx-auto max-w-[1100px] px-6 py-12">
		<div class="flex flex-col items-center justify-between gap-8 sm:flex-row sm:items-start">
			<!-- Brand -->
			<div>
				<a href="/" class="font-display text-2xl text-foreground">
					NW<em class="text-accent">OS</em>
				</a>
				<p class="mt-2 max-w-xs text-sm text-muted-foreground">Narrative Work OS — by Numen Games.</p>
			</div>

			<!-- Nav links -->
			<div class="flex flex-col gap-2 text-center sm:text-left">
				<span class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Navigation</span>
				<a href="/" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Home</a>
				<a href="/velo" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Deploy workspace</a>
			</div>

			<!-- Social links -->
			<div class="flex flex-col gap-2 text-center sm:text-left">
				<span class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Social</span>
				{
					socialLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-accent">
							{link.label}
						</a>
					))
				}
			</div>
		</div>

		<!-- Licence. C-005: a file with no declared licence defaults to all rights
		     reserved, and "declaring is what liberates". This page sells File over
		     App and no lock-in, so the footer must state the regime the repository
		     actually carries — AGPL-3.0-only for this service, per REUSE.toml —
		     rather than reserve rights the licence has already granted. -->
		<div class="mt-12 border-t border-border/50 pt-6 text-center">
			<p class="font-mono text-xs text-dim">
				&copy; {new Date().getFullYear()} Numen Games S.L. — this service is free software under
				<a href="https://github.com/numengames/nwos-deploy/blob/main/LICENSES/AGPL-3.0-only.txt" class="underline underline-offset-2 transition-colors hover:text-foreground">AGPL-3.0-only</a>. Per-path regimes are declared in
				<a href="https://github.com/numengames/nwos-deploy/blob/main/REUSE.toml" class="underline underline-offset-2 transition-colors hover:text-foreground">REUSE.toml</a>.
			</p>
		</div>
	</div>
</footer>
