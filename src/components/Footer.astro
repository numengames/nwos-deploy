---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// The house footer, the same shape on the four sites (numinia.org,
// numinia.com, numen.games, nwos.numen.games — Oracle instruction,
// 2026-09-16). Its job is to reduce uncertainty: where am I, where else can
// I go, what is this thing, which build am I reading.
//
//   brand + one line    Navigation    Numen Games       Legal
//                                     (the four sites)  Social
//   ────────────────────────────────────────────────────────────
//   scarab  by Numen Games — we build for a better future.        skull
//           licence · telemetry · version · commit
//
// The skull at the end of the closing line keeps the epitaph: the
// manifesto closes on it (canon CAN-002), so every page does too. Hover,
// focus or a tap shows it; Escape closes it. English everywhere, like the
// signature, and never "fixed": "did not let us alone" is literal on
// purpose.
//
// No copyright line and no "all rights reserved": this service is free
// software under AGPL-3.0-only, declared per path in REUSE.toml (C-005) —
// a blanket reservation contradicted the licence it had already granted.
// The signature is brand voice and is never translated.
import Icon from "@/components/Icon.astro";
import { navItems } from "@/data/navigation";
import { socialLinks } from "@/data/social-links";
import { HOUSE_LINKS, THIS_SITE } from "@/data/house-links";
import { LEGAL_PAGES, legalHref } from "@/data/legal";
import { VERSION, COMMIT_SHA, COMMIT_URL, LICENSE_URL } from "@/lib/build-info";
// The scarab closes every piece, never opens it. Local copy of the mark
// (reserved, see REUSE.toml) until a brand package exists to install from.
import scarab from "@/brand/Khepri_Logo.svg?raw";

// Phosphor "skull", regular weight (MIT), exactly as STD-037 gives it.
const skull = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M92,104a28,28,0,1,0,28,28A28,28,0,0,0,92,104Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,92,144Zm72-40a28,28,0,1,0,28,28A28,28,0,0,0,164,104Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,164,144ZM128,16C70.65,16,24,60.86,24,116c0,34.1,18.27,66,48,84.28V216a16,16,0,0,0,16,16h80a16,16,0,0,0,16-16V200.28C213.73,182,232,150.1,232,116,232,60.86,185.35,16,128,16Zm44.12,172.69a8,8,0,0,0-4.12,7V216H152V192a8,8,0,0,0-16,0v24H120V192a8,8,0,0,0-16,0v24H88V195.69a8,8,0,0,0-4.12-7C56.81,173.69,40,145.84,40,116c0-46.32,39.48-84,88-84s88,37.68,88,84C216,145.83,199.19,173.69,172.12,188.69Z"/></svg>`;
// Canon CAN-002: the manifesto closes on this epitaph.
const EPITAPH = "They dreamed and experimented life, they imagined and took action. They were part of the fight to change the model, they did not let us alone, they built a game with which to create a better world.";

// Navigation: the header's items plus the deploy page the header does not
// list. Two columns once it is long.
const nav = [{ label: "Home", href: "/", id: "home" }, { label: "How it works", href: "/how-it-works", id: "how" }, ...navItems.filter((n) => n.href), { label: "Try it", href: "/velo", id: "velo" }];
const twoColumns = nav.length > 4;
// Filled top-to-bottom so the header's order survives: down the first
// column, then the second.
const rows = Math.ceil(nav.length / 2);

const link = "flex min-h-[44px] items-center justify-center text-sm text-muted-foreground transition-colors hover:text-foreground sm:min-h-0 sm:justify-start sm:py-1";
const heading = "mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim";
---

<footer class="border-t border-border">
	<div class="mx-auto max-w-[1100px] px-6 py-12">
		<div class="grid grid-cols-1 gap-8 text-center sm:grid-cols-[1.4fr_1fr_1.2fr_1fr] sm:text-left">
			<div>
				<a href="/" class="inline-flex min-h-[44px] items-center font-display text-xl text-foreground">
					Narrative Work OS
				</a>
				<p class="mx-auto mt-2 max-w-xs text-sm text-muted-foreground sm:mx-0">The service: a workspace for your organisation, generated from the NWOS mould. Markdown, git and agents — nothing proprietary.</p>
				<!-- STD-037 SIT-001: every house footer invites patronage in plain sight.
				     Sold on numinia.com only (OPS-014), so it opens there, at /back. -->
				<a href="https://numinia.com/back/" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-[44px] items-center gap-2 rounded-[6px] border border-accent px-3 text-sm font-medium text-foreground transition-colors hover:bg-accent/10 sm:min-h-[40px]">
					<Icon name="coffee" size={18} /> Back Numinia
				</a>
			</div>

			<nav aria-label="Navigation" class="flex flex-col gap-2">
				<span class={heading}>Navigation</span>
				<div class:list={["grid gap-x-6", twoColumns ? "grid-cols-2 grid-flow-col" : "grid-cols-1"]} style={twoColumns ? `grid-template-rows: repeat(${rows}, auto)` : undefined}>
					{nav.map((n) => (
						<a href={n.href} class={link}>
							{n.label}
						</a>
					))}
				</div>
			</nav>

			<nav aria-label="Numen Games" class="flex flex-col gap-2">
				<span class={heading}>Numen Games</span>
				{HOUSE_LINKS.map((site) =>
					site.id === THIS_SITE ? (
						<span class="flex items-center justify-center gap-2 text-sm text-foreground sm:justify-start sm:py-1" aria-current="page">
							{site.label}
							<span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim">you are here</span>
						</span>
					) : (
						<a href={site.href} target="_blank" rel="noopener noreferrer" class={link} title={site.what}>
							{site.label}
						</a>
					),
				)}
			</nav>

			<div class="flex flex-col gap-2">
				<nav aria-label="Legal" class="flex flex-col gap-2">
					<span class={heading}>Legal</span>
					{LEGAL_PAGES.map((p) => (
						<a href={legalHref(p.slug)} class={link}>
							{p.label}
						</a>
					))}
					<!-- Reopens the cookie notice (src/components/CookieNotice.astro). -->
					<button type="button" data-cookie-choice class={`${link} text-left`}>
						Change my cookie choice
					</button>
				</nav>
				{socialLinks.length > 0 && (
					<nav aria-label="Social" class="mt-4 flex flex-col gap-2">
						<span class={heading}>Social</span>
						{socialLinks.map((s) => (
							<a href={s.href} target="_blank" rel="noopener noreferrer" class={link}>
								{s.label}
							</a>
						))}
					</nav>
				)}
			</div>
		</div>

		<div class="mt-12 flex flex-col items-center gap-4 border-t border-border/50 pt-6 text-center sm:flex-row sm:text-left">
			<span class="escarabajo inline-flex text-dim" aria-hidden="true" set:html={scarab} />
			<div>
				<p class="text-sm text-muted-foreground">
					by <a href="https://numen.games" target="_blank" rel="noopener noreferrer" class="text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-accent">
						Numen Games
					</a> — we build for a better future.
				</p>
				<p class="mt-1 font-mono text-[0.65rem] text-dim">
					<a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent" title="Free software, AGPL-3.0-only; docs CC-BY-4.0; brand reserved. The per-path map is REUSE.toml">
						Open by licence, per file
					</a>
					{" · "}
					<a href="/telemetry" class="transition-colors hover:text-accent" title="Measurements of this service — version and commit today">
						Telemetry
					</a>
					{" · "}
					<a href="/updates" class="transition-colors hover:text-accent" title="What changed in each version">
						{VERSION}
					</a>
					{" · "}
					{COMMIT_URL ? (
						<a href={COMMIT_URL} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent" title="See this commit on GitHub">
							{COMMIT_SHA}
						</a>
					) : (
						COMMIT_SHA
					)}
				</p>
			</div>
			<div class="epitafio relative sm:ml-auto" data-epitaph>
				<button type="button" aria-label="Epitaph" aria-expanded="false" aria-describedby="footer-epitaph" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[6px] text-dim transition-colors hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:min-h-[32px] sm:min-w-[32px]" data-epitaph-toggle>
					<span class="calavera inline-flex" aria-hidden="true" set:html={skull} />
				</button>
				<p id="footer-epitaph" role="tooltip" class="epitafio-texto absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-[32ch] -translate-x-1/2 rounded-[8px] border border-border bg-card px-3 py-2 text-left text-sm italic text-card-foreground shadow-lg sm:left-auto sm:right-0 sm:translate-x-0">
					{EPITAPH}
				</p>
			</div>
		</div>
	</div>
</footer>

<script>
	// The epitaph (CAN-002): hover or focus shows it (CSS), a click or tap
	// pins it open or closed, Escape closes it. No navigation.
	for (const box of document.querySelectorAll<HTMLElement>("[data-epitaph]")) {
		const btn = box.querySelector<HTMLButtonElement>("[data-epitaph-toggle]");
		if (!btn) continue;
		const set = (open: boolean) => {
			btn.setAttribute("aria-expanded", String(open));
			box.toggleAttribute("data-open", open);
		};
		btn.addEventListener("click", () => {
			box.removeAttribute("data-dismissed");
			set(btn.getAttribute("aria-expanded") !== "true");
		});
		box.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			set(false);
			box.setAttribute("data-dismissed", "");
		});
		box.addEventListener("mouseleave", () => box.removeAttribute("data-dismissed"));
		btn.addEventListener("blur", () => box.removeAttribute("data-dismissed"));
	}
</script>

<style>
	/* The mark in muted ink, 28px, never in colour. */
	.escarabajo :global(svg) {
		width: 28px;
		height: 28px;
	}

	/* The skull in the same muted ink, 20px, never in colour. */
	.calavera :global(svg) {
		width: 20px;
		height: 20px;
	}

	/* The epitaph: hidden until hover, keyboard focus or a tap pins it.
	   Escape dismisses it even while hovered or focused. */
	.epitafio-texto {
		visibility: hidden;
		opacity: 0;
		transition:
			opacity 150ms ease,
			visibility 150ms;
	}
	.epitafio:hover .epitafio-texto,
	.epitafio:has(button:focus-visible) .epitafio-texto,
	.epitafio[data-open] .epitafio-texto {
		visibility: visible;
		opacity: 1;
	}
	.epitafio[data-dismissed]:not([data-open]) .epitafio-texto {
		visibility: hidden;
		opacity: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.epitafio-texto {
			transition: none;
		}
	}
</style>
