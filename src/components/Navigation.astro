---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
import { navItems } from "@/data/navigation";
// Phosphor regular, from the house subset (MIT, see REUSE.toml).
import caretDown from "@/icons/caret-down.svg?raw";
import list from "@/icons/list.svg?raw";
import moonStars from "@/icons/moon-stars.svg?raw";
import sun from "@/icons/sun.svg?raw";

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const numaniaIds = navItems
  .find((i) => i.id === "numinia")
  ?.children?.map((c) => c.id) ?? [];
const numaniaActive = numaniaIds.includes(activeNav ?? "");
---

<nav class="sticky top-0 z-50 border-b border-border/50 bg-background/85 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-[1100px] items-center justify-between px-6">
    <a href="/" class="font-display text-xl text-foreground transition-colors hover:text-accent">
      NW<em class="text-accent">OS</em>
    </a>

    <div class="flex items-center gap-2">
    <!-- Desktop nav -->
    <div class="hidden items-center gap-1 sm:flex">
      <a
        href="/velo"
        class:list={[
          "mr-2 rounded-full border px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-all",
          activeNav === "velo"
            ? "border-accent bg-accent/10 text-accent"
            : "border-accent/40 text-accent/80 hover:border-accent hover:bg-accent/10 hover:text-accent",
        ]}
      >
        Try NWOS
      </a>
      {navItems.map((item) => {
        if (item.children) {
          return (
            <div class="relative" data-dropdown>
              <button
                data-dropdown-btn
                class:list={[
                  "flex items-center gap-1 rounded-full px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-all",
                  numaniaActive
                    ? "border border-accent bg-accent/10 text-accent"
                    : "border border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground",
                ]}
              >
                {item.label}
                <span class="icon-10 inline-flex transition-transform duration-200" data-chevron set:html={caretDown} />
              </button>
              <!-- invisible bridge to prevent gap-triggered close -->
              <div class="absolute right-0 top-full h-3 w-full" data-bridge></div>
              <!-- Dropdown panel -->
              <div
                data-dropdown-panel
                class="absolute right-0 top-full mt-3 hidden w-48 rounded-xl border border-border bg-background/95 py-2 shadow-xl backdrop-blur-xl"
              >
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      "block px-4 py-2 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
                      activeNav === child.id
                        ? "bg-accent/10 text-accent"
                        : "text-muted-foreground hover:bg-card hover:text-foreground",
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-4 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-all",
              activeNav === item.id
                ? "border border-accent bg-accent/10 text-accent"
                : "border border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <!-- The mode switch (DSN-016): the icon shows where a tap leads —
         moon with stars to the night, sun to the day. -->
    <button
      type="button"
      data-mode-switch
      class="mode-switch flex h-11 w-11 items-center justify-center rounded-control text-muted-foreground transition-colors hover:bg-card hover:text-foreground"
      aria-label="Modo de color: día o noche"
      title="Modo de color: día o noche"
    >
      <span class="solo-diurno" set:html={moonStars} />
      <span class="solo-nocturno" set:html={sun} />
    </button>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-card hover:text-foreground sm:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="icon-18 inline-flex" set:html={list} />
    </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border/50 bg-background/95 backdrop-blur-xl sm:hidden">
    <div class="flex flex-col gap-1 px-6 py-4">
      <a
        href="/velo"
        class:list={[
          "rounded-lg px-4 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
          activeNav === "velo"
            ? "bg-accent/10 text-accent"
            : "text-accent/80 hover:bg-accent/10 hover:text-accent",
        ]}
      >
        Try NWOS
      </a>
      {navItems.map((item) => {
        if (item.children) {
          return (
            <div>
              <div class:list={[
                "rounded-lg px-4 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.15em]",
                numaniaActive ? "text-accent" : "text-muted-foreground",
              ]}>
                {item.label}
              </div>
              <div class="ml-4 flex flex-col gap-1 border-l border-border/50 pl-3">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      "rounded-lg px-3 py-2 font-mono text-[0.65rem] uppercase tracking-[0.15em] transition-colors",
                      activeNav === child.id
                        ? "bg-accent/10 text-accent"
                        : "text-muted-foreground hover:bg-card hover:text-foreground",
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-4 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.15em] transition-colors",
              activeNav === item.id
                ? "bg-accent/10 text-accent"
                : "text-muted-foreground hover:bg-card hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .icon-10 :global(svg) {
    width: 10px;
    height: 10px;
    display: block;
  }
  .icon-18 :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
  }
  .mode-switch :global(svg) {
    width: 20px;
    height: 20px;
    display: block;
  }
  /* Pure-CSS swap keyed on the html attribute: no flash, no JS paint. */
  :global(html:not([data-modo="diurno"])) .solo-diurno,
  :global(html[data-modo="diurno"]) .solo-nocturno {
    display: none;
  }
</style>

<script>
  // Day and night (DSN-016), numinia.com's switch copied. Until the visitor
  // chooses, the page follows the device; a choice is remembered under
  // numinia-modo and ends the following.
  const root = document.documentElement;
  const applyModo = (modo: string) => {
    if (modo === "diurno") root.dataset.modo = "diurno";
    else delete root.dataset.modo;
  };
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", (event) => {
    try {
      if (localStorage.getItem("numinia-modo")) return;
    } catch {
      return;
    }
    applyModo(event.matches ? "diurno" : "nocturno");
  });
  document.querySelector("[data-mode-switch]")?.addEventListener("click", () => {
    const next = root.dataset.modo === "diurno" ? "nocturno" : "diurno";
    applyModo(next);
    try {
      localStorage.setItem("numinia-modo", next);
    } catch {
      /* private mode: the choice lives for this page only */
    }
  });

  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!open));
    });
  }

  // Desktop dropdowns
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const dropBtn = dropdown.querySelector<HTMLElement>("[data-dropdown-btn]");
    const panel = dropdown.querySelector<HTMLElement>("[data-dropdown-panel]");
    const bridge = dropdown.querySelector<HTMLElement>("[data-bridge]");
    const chevron = dropdown.querySelector<HTMLElement>("[data-chevron]");

    if (!dropBtn || !panel) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function openPanel() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      panel!.classList.remove("hidden");
      if (bridge) bridge.classList.remove("hidden");
      chevron?.classList.add("rotate-180");
    }

    function scheduleClose() {
      closeTimer = setTimeout(() => {
        panel!.classList.add("hidden");
        if (bridge) bridge.classList.add("hidden");
        chevron?.classList.remove("rotate-180");
        closeTimer = null;
      }, 120);
    }

    // Click toggle
    dropBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (panel!.classList.contains("hidden")) {
        openPanel();
      } else {
        scheduleClose();
      }
    });

    // Close on outside click
    document.addEventListener("click", () => {
      if (!panel!.classList.contains("hidden")) scheduleClose();
    });
    panel.addEventListener("click", (e) => e.stopPropagation());

    // Hover — button, bridge and panel all keep it open
    [dropdown, bridge, panel].forEach((el) => {
      if (!el) return;
      el.addEventListener("mouseenter", () => openPanel());
      el.addEventListener("mouseleave", () => scheduleClose());
    });
  });
</script>
