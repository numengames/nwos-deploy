---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// The bar, drawn as numinia.org draws it (STD-023 §23, BLU-009 §12): the
// wordmark on the left, the entries as Mono labels each with a 14 px
// Phosphor icon, the active one in primary ink over a 2 px Turquesa line,
// and the day-and-night switch. On a phone one 44 px button opens a
// full-screen panel with the same entries and nothing else.
//
// NWOS is a Numen Games service, so the bar opens with the Numen Games
// wordmark — the canonical file, in currentColor, named for a screen
// reader. Never typed text in place of a logo (the Oracle, 2026-09-29).
import Icon from "@/components/Icon.astro";
import wordmark from "@/brand/Numen_Games_Horizontal_Word.svg?raw";

interface Props {
	activeNav?: string;
}

const { activeNav } = Astro.props;

const entries = [
	{ id: "nwos", label: "NWOS", href: "/", icon: "package" },
	{ id: "how", label: "How it works", href: "/how-it-works", icon: "book-open" },
	{ id: "plans", label: "Plans", href: "/#plans", icon: "users" },
	{ id: "velo", label: "Try it · 29 €", href: "/velo", icon: "lightning" },
];

// The bar's own text style: Mono, uppercase, tracked — type.etiqueta.
const etiqueta = "font-mono text-[0.7rem] uppercase tracking-[0.15em]";
---

<nav class="sticky top-0 z-50 border-b border-border/50 bg-background/85 backdrop-blur-xl" aria-label="Primary">
	<div class="mx-auto flex h-14 max-w-[1100px] items-center justify-between px-6">
		<a href="/" aria-label="Numen Games" class="wordmark flex min-h-[44px] items-center text-foreground transition-colors hover:text-accent" set:html={wordmark} />

		<div class="flex items-center gap-1">
			<div class="hidden items-center gap-1 md:flex">
				{
					entries.map((e) => (
						<a href={e.href} aria-current={activeNav === e.id ? "page" : undefined} class:list={["flex min-h-[44px] items-center gap-2 px-3 transition-colors", etiqueta, activeNav === e.id ? "border-b-2 border-teal text-foreground" : "border-b-2 border-transparent text-muted-foreground hover:text-foreground"]}>
							<Icon name={e.icon} size={14} /> {e.label}
						</a>
					))
				}
			</div>

			<!-- The mode switch (DSN-016): the icon shows the mode you are in —
			     moon with stars at night, sun by day. -->
			<button type="button" data-mode-switch class="flex h-11 w-11 items-center justify-center rounded-control text-muted-foreground transition-colors hover:bg-card hover:text-foreground md:ml-1" aria-label="Colour mode: day or night" title="Colour mode: day or night">
				<span class="solo-nocturno"><Icon name="moon-stars" size={18} /></span>
				<span class="solo-diurno"><Icon name="sun" size={18} /></span>
			</button>

			<!-- Mobile: the button that opens the full-screen panel -->
			<button id="mobile-menu-btn" class="flex h-11 w-11 items-center justify-center rounded-control border border-border text-muted-foreground transition-colors hover:bg-card hover:text-foreground md:hidden" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
				<span data-icon-open><Icon name="list" size={18} /></span>
				<span data-icon-close class="hidden"><Icon name="x" size={18} /></span>
			</button>
		</div>
	</div>
</nav>

<!-- Outside <nav> on purpose: the bar's backdrop-filter makes it the
     containing block of any position:fixed child, which would collapse
     this panel to the bar's height. -->
<div id="mobile-menu" class="fixed inset-x-0 bottom-0 top-14 z-40 hidden overflow-y-auto bg-background/95 backdrop-blur-xl md:hidden">
	<div class="mx-auto flex max-w-[1100px] flex-col gap-1 px-6 py-4">
		{
			entries.map((e) => (
				<a href={e.href} aria-current={activeNav === e.id ? "page" : undefined} class:list={["flex min-h-[44px] items-center gap-2 border-b border-border/50", etiqueta, activeNav === e.id ? "text-foreground" : "text-muted-foreground"]}>
					<Icon name={e.icon} size={14} /> {e.label}
				</a>
			))
		}
	</div>
</div>

<style>
	/* The wordmark at 20 px high, 16 on a phone, as numinia.org draws it. */
	.wordmark :global(svg) {
		height: 20px;
		width: auto;
		display: block;
	}
	@media (max-width: 48rem) {
		.wordmark :global(svg) {
			height: 16px;
		}
	}
	/* Pure-CSS swap keyed on the html attribute: no flash, no JS paint. */
	:global(html:not([data-modo="diurno"])) .solo-diurno,
	:global(html[data-modo="diurno"]) .solo-nocturno {
		display: none;
	}
</style>

<script>
	// Day and night (DSN-016), numinia.com's switch copied. Until the visitor
	// chooses, the page follows the device; a choice is remembered under
	// numinia-modo and ends the following.
	const root = document.documentElement;
	const applyModo = (modo: string) => {
		if (modo === "diurno") root.dataset.modo = "diurno";
		else delete root.dataset.modo;
	};
	matchMedia("(prefers-color-scheme: light)").addEventListener("change", (event) => {
		try {
			if (localStorage.getItem("numinia-modo")) return;
		} catch {
			return;
		}
		applyModo(event.matches ? "diurno" : "nocturno");
	});
	document.querySelector("[data-mode-switch]")?.addEventListener("click", () => {
		const next = root.dataset.modo === "diurno" ? "nocturno" : "diurno";
		applyModo(next);
		try {
			localStorage.setItem("numinia-modo", next);
		} catch {
			/* private mode: the choice lives for this page only */
		}
	});

	// Mobile panel: toggle, swap the glyph, lock the page scroll while open.
	const btn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");
	if (btn && menu) {
		btn.addEventListener("click", () => {
			const open = menu.classList.toggle("hidden") === false;
			btn.setAttribute("aria-expanded", String(open));
			btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			btn.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
			btn.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
			document.body.style.overflow = open ? "hidden" : "";
		});
	}
</script>
