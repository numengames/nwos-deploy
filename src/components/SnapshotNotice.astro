---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
// Aviso de honestidad temporal: estas páginas describen el estado del sistema
// en una fecha concreta y no se actualizan en tiempo real contra el repo canon.
interface Props {
	fecha?: string;
	lang?: "es" | "en";
}
const { fecha = "7 de abril de 2026", lang = "es" } = Astro.props;
const texto =
	lang === "en"
		? `Historical snapshot — this page reflects the state of the system as of April 7, 2026 and is not updated in real time. The live source of truth is the`
		: `Snapshot histórico — esta página refleja el estado del sistema a ${fecha} y no se actualiza en tiempo real. La fuente de verdad viva es el`;
const repoLabel = lang === "en" ? "canon repo" : "repo canon";
---

<div class="mx-auto max-w-[1100px] px-6 pt-6">
	<div class="flex items-start gap-3 rounded-lg border border-yellow/30 bg-yellow/5 px-4 py-3">
		<span class="text-sm leading-none pt-0.5">📸</span>
		<p class="font-mono text-[0.7rem] leading-relaxed text-yellow/90">
			{texto}
			<a
				href="https://github.com/numengames/numinia-digital-agents"
				target="_blank"
				rel="noopener noreferrer"
				class="underline hover:text-yellow transition-colors">{repoLabel}</a
			>.
		</p>
	</div>
</div>
