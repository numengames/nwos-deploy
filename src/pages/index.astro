---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// The home page sells (the Oracle, 2026-09-30): what NWOS does for an
// organisation, the path of the sale — a paid trial, then on your own or
// accompanied for 8 or 16 weeks — and the questions a buyer asks. How the
// system works is on /how-it-works. The offer is read from src/data/offer.ts.
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { TRIAL } from "@/data/trial";
import { PATH, PLANS, SPANS, FAQ, contactHref } from "@/data/offer";
import { DEMO_WORKSPACE_SLUG } from "@/lib/demo";

const outcomes = [
	{ icon: "archive", title: "It remembers", text: "Every decision, mission and report is written down where people and agents both read it. Nobody has to be in the meeting to know what was decided." },
	{ icon: "robot", title: "Agents that know you", text: "AI agents start each session by reading your organisation — its rules, its history, its work in progress — instead of starting from zero." },
	{ icon: "shield-check", title: "People decide", text: "Agents propose and do; a named person approves anything that leaves the house. Every change says who made it and who approved it." },
	{ icon: "file-text", title: "Yours, in plain files", text: "Text files in a repository you own. No platform to rent, nothing locked in: if you leave, everything goes with you." },
];
---

<Layout title="NWOS — your organisation, ready for AI · Numen Games" description={`A workspace where your people and your AI agents share one memory. Try it for ${TRIAL.priceEur} €: your organisation's workspace in two minutes.`} canonicalPath="" activeNav="nwos">
	<!-- Hero -->
	<section class="pb-16 pt-16 sm:pt-24">
		<div class="mx-auto max-w-[1100px] px-6">
			<span class="mb-4 inline-block font-mono text-[0.7rem] font-medium uppercase tracking-[0.25em] text-accent opacity-0 animate-entrada">NWOS · by Numen Games</span>
			<h1 class="max-w-3xl font-display text-4xl font-normal tracking-[-0.025em] text-foreground opacity-0 animate-entrada-1 sm:text-5xl lg:text-6xl">Your organisation, ready to work with AI.</h1>
			<p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground opacity-0 animate-entrada-2">NWOS gives your people and your AI agents one shared memory: what you are, what you decided, what is in progress. Agents do the work; your people decide. Start by seeing your own.</p>
			<div class="mt-8 flex flex-wrap items-center gap-3 opacity-0 animate-entrada-2">
				<a href="/velo" class="inline-flex min-h-[44px] items-center gap-2 rounded-control bg-interactivo px-6 text-sm font-medium text-white transition-colors duration-instante ease-ciclo hover:bg-interactivo-hover active:bg-interactivo-activo">
					Try it with your organisation · {TRIAL.priceEur} €
				</a>
				<a href={`/workspace/${DEMO_WORKSPACE_SLUG}`} class="inline-flex min-h-[44px] items-center gap-2 rounded-control border border-border px-6 text-sm font-medium text-muted-foreground transition-colors hover:border-accent hover:text-accent">
					{" "}
					See an example, free{" "}
				</a>
			</div>
		</div>
	</section>

	<div class="mx-auto max-w-[1100px] space-y-24 px-6 pb-24">
		<!-- What it does -->
		<section>
			<div class="mb-6 flex items-center gap-3">
				<span class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-accent">What it does for you</span>
				<span class="h-px flex-1 bg-border"></span>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				{outcomes.map((o) => (
					<div class="rounded-marco border border-border bg-card p-6">
						<Icon name={o.icon} size={22} class="text-accent" />
						<h2 class="mt-3 font-display text-xl text-foreground">{o.title}</h2>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{o.text}</p>
					</div>
				))}
			</div>
			<p class="mt-5 text-sm text-muted-foreground">
				How the pieces fit — people, agents, the shared memory — is drawn on <a href="/how-it-works" class="text-foreground underline underline-offset-4 hover:text-accent">
					How it works
				</a>.
			</p>
		</section>

		<!-- The path -->
		<section id="path">
			<div class="mb-6 flex items-center gap-3">
				<span class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-accent">How you start</span>
				<span class="h-px flex-1 bg-border"></span>
			</div>
			<ol class="grid gap-4 sm:grid-cols-3">
				{PATH.map((s) => (
					<li class="rounded-marco border border-border bg-card p-6">
						<span class="font-mono text-[0.7rem] tracking-[0.2em] text-dim">{s.n}</span>
						<h3 class="mt-2 font-display text-lg text-foreground">{s.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.text}</p>
					</li>
				))}
			</ol>
		</section>

		<!-- Two ways on -->
		<section id="plans">
			<div class="mb-6 flex items-center gap-3">
				<span class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-accent">After the trial: two ways on</span>
				<span class="h-px flex-1 bg-border"></span>
			</div>
			<div class="grid gap-4 md:grid-cols-2">
				{PLANS.map((p) => (
					<div data-plan={p.id} class:list={["flex flex-col rounded-marco border bg-card p-6", p.id === "accompanied" ? "border-accent/50" : "border-border"]}>
						<div class="flex items-center gap-2">
							<Icon name={p.id === "own" ? "user" : "users"} size={20} class="text-accent" />
							<h3 class="font-display text-2xl text-foreground">{p.name}</h3>
						</div>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.forWhom}</p>
						<p class="mt-5 font-display text-2xl text-foreground">
							{p.price} <span class="font-mono text-[0.65rem] uppercase tracking-[0.15em] text-dim">{p.priceNote}</span>
						</p>
						<ul class="mt-4 flex-1 space-y-2">
							{p.includes.map((i) => (
								<li class="flex items-start gap-2 text-sm text-muted-foreground">
									<Icon name="check" size={16} class="mt-0.5 text-green" />
									<span>{i}</span>
								</li>
							))}
						</ul>
						<a href={p.cta.href} class:list={["mt-6 inline-flex min-h-[44px] items-center justify-center rounded-control px-6 text-sm font-medium transition-colors", p.id === "own" ? "bg-interactivo text-white hover:bg-interactivo-hover" : "border border-border text-foreground hover:border-accent hover:text-accent"]}>
							{p.cta.label}
						</a>
					</div>
				))}
			</div>

			<!-- 8 or 16 weeks -->
			<div class="mt-4 grid gap-4 sm:grid-cols-2">
				{SPANS.map((s) => (
					<div class="flex gap-4 rounded-marco border border-border/60 p-5">
						<div class="flex-shrink-0 text-center">
							<p class="font-display text-3xl text-foreground">{s.weeks}</p>
							<p class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-dim">weeks</p>
						</div>
						<div>
							<p class="text-sm font-semibold text-foreground">{s.title}</p>
							<p class="mt-1 text-sm leading-relaxed text-muted-foreground">{s.text}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Proof -->
		<section class="rounded-marco border border-border bg-card p-6 sm:p-8">
			<p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent">We run on it</p>
			<p class="mt-3 max-w-3xl text-base leading-relaxed text-foreground">
				Numen Games is run this way, in public: every decision, standard, mission and report of the company, and the agents that write them, are on <a href="https://numinia.org" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-accent">
					numinia.org
				</a>. What we sell is what we use.
			</p>
		</section>

		<!-- FAQ -->
		<section>
			<div class="mb-6 flex items-center gap-3">
				<span class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-accent">Questions</span>
				<span class="h-px flex-1 bg-border"></span>
			</div>
			<div class="divide-y divide-border rounded-marco border border-border">
				{FAQ.map((f) => (
					<details class="group p-5">
						<summary class="cursor-pointer list-none text-sm font-medium text-foreground">{f.q}</summary>
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
					</details>
				))}
			</div>
		</section>

		<!-- Closing CTA -->
		<section class="text-center">
			<h2 class="font-display text-3xl text-foreground">See your organisation in NWOS.</h2>
			<p class="mx-auto mt-3 max-w-md text-sm text-muted-foreground">Two minutes, {TRIAL.priceEur} € with VAT, and the workspace is yours.</p>
			<div class="mt-6 flex flex-wrap justify-center gap-3">
				<a href="/velo" class="inline-flex min-h-[44px] items-center rounded-control bg-interactivo px-6 text-sm font-medium text-white transition-colors hover:bg-interactivo-hover">
					{" "}
					Try it · {TRIAL.priceEur} €{" "}
				</a>
				<a href={contactHref("NWOS")} class="inline-flex min-h-[44px] items-center rounded-control border border-border px-6 text-sm font-medium text-muted-foreground transition-colors hover:border-accent hover:text-accent">
					{" "}
					Talk to us first{" "}
				</a>
			</div>
		</section>
	</div>
</Layout>
