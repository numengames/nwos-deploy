---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
//
// The paid trial. Redesigned 2026-10-04 after the panel: the form is the
// page. Before, a 100 vh star hero repeated the home page and pushed the
// form below the fold, and a second animated canvas ran on top of the
// Layout's sky (two loops, colours off the palette). The page now opens on
// its own H1 and the form, with the free example named beside it.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import DeployForm from "@/components/DeployForm";
import { DEMO_WORKSPACE_SLUG, DEMO_WORKSPACE_NAME } from "@/lib/demo";
import { TRIAL } from "@/data/trial";

export const prerender = false;
---

<Layout title={`Try it with your organisation · ${TRIAL.priceEur} € · NWOS · Numen Games`} description={`Your organisation's NWOS workspace with four founding documents drafted by AI, in two minutes. ${TRIAL.priceEur} € with VAT, deducted if you then hire us.`} canonicalPath="/velo" activeNav="velo">
	<PageHero label={`Paid trial · ${TRIAL.priceEur} €`} title="See your organisation in NWOS" description="A private repository with the whole NWOS structure and four founding documents, drafted by AI from what is public about you. Two minutes." />

	<section class="pb-24">
		<div class="mx-auto max-w-[1100px] px-6">
			<DeployForm client:visible />

			<div class="mx-auto mt-10 max-w-md rounded-marco border border-border/60 p-5 text-center">
				<p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">Rather see one first? It is free</p>
				<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
					<a href={`/workspace/${DEMO_WORKSPACE_SLUG}`} class="text-foreground underline underline-offset-4 hover:text-accent">
						Open the example workspace
					</a> — {DEMO_WORKSPACE_NAME}, an invented organisation, written exactly the way yours would be. No payment, no email.
				</p>
				<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
					Or read <a href="https://numinia.org" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 hover:text-accent">
						numinia.org
					</a>, where Numen Games runs its own company this way, in public.
				</p>
			</div>
		</div>
	</section>
</Layout>
