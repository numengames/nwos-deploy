---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: AGPL-3.0-only
import Layout from "@/layouts/Layout.astro";
import DeployForm from "@/components/DeployForm";
import { DEMO_WORKSPACE_SLUG } from "@/lib/demo";

export const prerender = false;
---

<Layout title="The Veil — NWOS" activeNav="velo">
	<!-- Star field hero -->
	<div class="velo-hero">
		<canvas id="stardust" class="absolute inset-0 h-full w-full"></canvas>

		<div class="relative z-10 flex flex-col items-center gap-8 text-center px-6">
			<p class="font-mono text-[0.7rem] uppercase tracking-[0.25em] text-accent">NWOS · Numen Workspace OS</p>
			<p class="velo-cta">Cross the threshold where your organisation wakes up.</p>
			<p class="max-w-md text-sm text-muted-foreground leading-relaxed">Deploy your organisation's documentation workspace in seconds. One click, a complete system with AI agents.</p>
			<a href="#deploy" class="velo-btn">
				Go to the form
			</a>
		</div>
	</div>

	<!-- Deploy form section -->
	<section id="deploy" class="py-20 border-t border-border/40">
		<div class="mx-auto max-w-[1100px] px-6">
			<div class="text-center mb-10">
				<p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">Iteration 1</p>
				<h2 class="font-display text-3xl font-normal tracking-[-0.025em] sm:text-4xl text-foreground mb-3">Deploy a workspace</h2>
				<p class="text-sm text-muted-foreground max-w-sm mx-auto">Creates a GitHub repository with your organisation's whole document structure, ready for the agents to fill in.</p>
			</div>

			<DeployForm client:visible />

			<!-- MIS-090: ver antes de desplegar, sin coste de generación -->
			<div class="mt-10 text-center">
				<p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-3">Want to see it first?</p>
				<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
					<a href={`/workspace/${DEMO_WORKSPACE_SLUG}`} class="font-mono text-[0.7rem] text-accent hover:text-accent/80 transition-colors">
						See an example workspace →
					</a>
					<a href="https://numinia.org" target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] text-dim hover:text-foreground transition-colors">
						See Numinia — the 5/5 reference →
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.velo-hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgb(var(--bg));
		overflow: hidden;
	}

	/* The sky is Nocturno only (STD-023, the sky): by day the paper shows. */
	:global(html[data-modo="diurno"]) #stardust {
		display: none;
	}

	.velo-cta {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.4rem, 3.5vw, 2.4rem);
		color: rgb(var(--text));
		letter-spacing: -0.025em;
		line-height: 1.35;
		max-width: 640px;
	}

	/* Ghost button (BLU-009 §7): the primary action is the form's own
	   button below; this one only takes the reader there. */
	.velo-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 500;
		color: rgb(var(--text-muted));
		border: 1px solid rgb(var(--border));
		padding: 0 1.5rem;
		border-radius: var(--radius-control);
		transition:
			color 120ms var(--ciclo),
			border-color 120ms var(--ciclo);
		text-decoration: none;
	}

	.velo-btn:hover {
		color: rgb(var(--accent));
		border-color: rgb(var(--accent));
	}
</style>

<script>
	const canvas = document.getElementById("stardust") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;

	let W = window.innerWidth;
	let H = window.innerHeight;
	canvas.width = W;
	canvas.height = H;

	window.addEventListener("resize", () => {
		W = window.innerWidth;
		H = window.innerHeight;
		canvas.width = W;
		canvas.height = H;
		initStars();
	});

	interface Star {
		x: number;
		y: number;
		r: number;
		alpha: number;
		alphaDir: number;
		speed: number;
		vx: number;
		vy: number;
		tier: number;
	}

	/** Escala de rareza canónica: STD-023, servida por --rareza-* en tokens.css
	 *  (generado del paquete @numengames/design-kit; ningún hex a mano aquí). */
	const rareza = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(`--rareza-${name}`).trim().replaceAll(" ", ",");
	const TIERS = [
		{ color: rareza("comun"), weight: 60, minR: 0.3, maxR: 1.2 }, // Común (STD-023: gris, no Arena)
		{ color: rareza("poco-comun"), weight: 25, minR: 0.5, maxR: 1.5 }, // Poco común
		{ color: rareza("raro"), weight: 10, minR: 0.6, maxR: 1.8 }, // Raro
		{ color: rareza("epico"), weight: 4, minR: 0.8, maxR: 2.5 }, // Épico
		{ color: rareza("legendario"), weight: 1, minR: 1.0, maxR: 3.0 }, // Legendario — Ámbar
	];

	const pool: number[] = [];
	TIERS.forEach((t, i) => {
		for (let w = 0; w < t.weight; w++) pool.push(i);
	});

	// STD-008 DSN-008: con movimiento reducido el cielo se detiene, no desaparece.
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const STAR_COUNT = 175;
	let stars: Star[] = [];

	function initStars() {
		stars = Array.from({ length: STAR_COUNT }, () => {
			const tier = pool[Math.floor(Math.random() * pool.length)];
			const t = TIERS[tier];
			return {
				x: Math.random() * W,
				y: Math.random() * H,
				r: t.minR + Math.random() * (t.maxR - t.minR),
				alpha: Math.random(),
				alphaDir: Math.random() > 0.5 ? 1 : -1,
				speed: Math.random() * 0.004 + 0.002,
				vx: (Math.random() - 0.5) * 0.06,
				vy: (Math.random() - 0.5) * 0.06,
				tier,
			};
		});
	}

	initStars();

	function draw() {
		ctx.clearRect(0, 0, W, H);

		for (const s of stars) {
			s.x += s.vx;
			s.y += s.vy;

			if (s.x < -2) s.x = W + 2;
			if (s.x > W + 2) s.x = -2;
			if (s.y < -2) s.y = H + 2;
			if (s.y > H + 2) s.y = -2;

			s.alpha += s.alphaDir * s.speed;
			if (s.alpha > 0.85) {
				s.alpha = 0.85;
				s.alphaDir = -1;
			}
			if (s.alpha < 0.05) {
				s.alpha = 0.05;
				s.alphaDir = 1;
			}

			ctx.beginPath();
			ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${TIERS[s.tier].color}, ${s.alpha})`;
			ctx.fill();
		}

		requestAnimationFrame(draw);
	}

	function drawStill() {
		ctx.clearRect(0, 0, W, H);
		for (const s of stars) {
			ctx.beginPath();
			ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${TIERS[s.tier].color}, 0.45)`;
			ctx.fill();
		}
	}

	if (reducedMotion) {
		drawStill();
	} else {
		draw();
	}
</script>
