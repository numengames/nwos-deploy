// SPDX-License-Identifier: AGPL-3.0-only
import Layout from "@/layouts/Layout.astro";
import DeployForm from "@/components/DeployForm";
import { DEMO_WORKSPACE_SLUG } from "@/lib/demo";

export const prerender = false;
---

<Layout title="El Velo — NWOS" activeNav="velo">
	<!-- Star field hero -->
	<div class="velo-hero">
		<canvas id="stardust" class="absolute inset-0 h-full w-full"></canvas>

		<div class="relative z-10 flex flex-col items-center gap-8 text-center px-6">
			<p class="font-mono text-[0.75rem] uppercase tracking-[0.2em] text-accent/80">NWOS · Numen Workspace OS</p>
			<p class="velo-cta">Cruza el umbral donde tu organización despierta.</p>
			<p class="max-w-md text-sm text-muted-foreground leading-relaxed">Despliega el workspace de documentación de tu organización en segundos. Un click, sistema completo con agentes IA.</p>
			<a href="#deploy" class="velo-btn"> Desplegar workspace ↓ </a>
		</div>
	</div>

	<!-- Deploy form section -->
	<section id="deploy" class="py-20 border-t border-border/40">
		<div class="mx-auto max-w-[1100px] px-6">
			<div class="text-center mb-10">
				<p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">Iteración 1</p>
				<h2 class="font-display text-3xl sm:text-4xl text-foreground mb-3">Deploy Workspace</h2>
				<p class="text-sm text-muted-foreground max-w-sm mx-auto">Crea un repositorio GitHub con toda la estructura documental de tu organización, listo para que los agentes lo pueblen.</p>
			</div>

			<DeployForm client:visible />

			<!-- MIS-090: ver antes de desplegar, sin coste de generación -->
			<div class="mt-10 text-center">
				<p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim mb-3">¿Quieres verlo antes?</p>
				<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
					<a href={`/workspace/${DEMO_WORKSPACE_SLUG}`} class="font-mono text-[0.7rem] text-accent hover:text-accent/80 transition-colors">Ver un workspace de ejemplo →</a>
					<a href="https://numinia.org" target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] text-dim hover:text-foreground transition-colors">Ver Numinia — la referencia 5/5 →</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.velo-hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #14110f;
		overflow: hidden;
	}

	.velo-cta {
		font-family: var(--font-display, Georgia, serif);
		font-size: clamp(1.4rem, 3.5vw, 2.4rem);
		color: rgba(249, 235, 220, 0.92);
		letter-spacing: 0.01em;
		line-height: 1.35;
		max-width: 640px;
		text-shadow: 0 0 40px rgba(1, 142, 161, 0.15);
	}

	.velo-btn {
		font-family: var(--font-mono, monospace);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: rgba(166, 218, 213, 0.8);
		border: 1px solid rgba(166, 218, 213, 0.25);
		padding: 0.6rem 1.8rem;
		border-radius: 999px;
		transition: all 200ms cubic-bezier(0.2, 0, 0, 1);
		text-decoration: none;
	}

	.velo-btn:hover {
		color: rgb(166, 218, 213);
		border-color: rgba(166, 218, 213, 0.6);
		box-shadow: 0 0 24px rgba(1, 142, 161, 0.12);
		background: rgba(1, 142, 161, 0.05);
	}
</style>

<script>
	const canvas = document.getElementById("stardust") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;

	let W = window.innerWidth;
	let H = window.innerHeight;
	canvas.width = W;
	canvas.height = H;

	window.addEventListener("resize", () => {
		W = window.innerWidth;
		H = window.innerHeight;
		canvas.width = W;
		canvas.height = H;
		initStars();
	});

	interface Star {
		x: number;
		y: number;
		r: number;
		alpha: number;
		alphaDir: number;
		speed: number;
		vx: number;
		vy: number;
		tier: number;
	}

	/** Escala de rareza canónica (Sistema de Diseño v5.0.0 §2.7.1 / §3.6). */
	const TIERS = [
		{ color: "249,235,220", weight: 60, minR: 0.3, maxR: 1.2 }, // Común — Arena
		{ color: "143,196,107", weight: 25, minR: 0.5, maxR: 1.5 }, // Poco común
		{ color: "93,155,214", weight: 10, minR: 0.6, maxR: 1.8 }, // Raro
		{ color: "169,139,224", weight: 4, minR: 0.8, maxR: 2.5 }, // Épico
		{ color: "239,165,23", weight: 1, minR: 1.0, maxR: 3.0 }, // Legendario — Ámbar
	];

	const pool: number[] = [];
	TIERS.forEach((t, i) => {
		for (let w = 0; w < t.weight; w++) pool.push(i);
	});

	// §2.7.1: con movimiento reducido el cielo se detiene, no desaparece.
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const STAR_COUNT = 175;
	let stars: Star[] = [];

	function initStars() {
		stars = Array.from({ length: STAR_COUNT }, () => {
			const tier = pool[Math.floor(Math.random() * pool.length)];
			const t = TIERS[tier];
			return {
				x: Math.random() * W,
				y: Math.random() * H,
				r: t.minR + Math.random() * (t.maxR - t.minR),
				alpha: Math.random(),
				alphaDir: Math.random() > 0.5 ? 1 : -1,
				speed: Math.random() * 0.004 + 0.002,
				vx: (Math.random() - 0.5) * 0.06,
				vy: (Math.random() - 0.5) * 0.06,
				tier,
			};
		});
	}

	initStars();

	function draw() {
		ctx.clearRect(0, 0, W, H);

		for (const s of stars) {
			s.x += s.vx;
			s.y += s.vy;

			if (s.x < -2) s.x = W + 2;
			if (s.x > W + 2) s.x = -2;
			if (s.y < -2) s.y = H + 2;
			if (s.y > H + 2) s.y = -2;

			s.alpha += s.alphaDir * s.speed;
			if (s.alpha > 0.85) {
				s.alpha = 0.85;
				s.alphaDir = -1;
			}
			if (s.alpha < 0.05) {
				s.alpha = 0.05;
				s.alphaDir = 1;
			}

			ctx.beginPath();
			ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${TIERS[s.tier].color}, ${s.alpha})`;
			ctx.fill();
		}

		requestAnimationFrame(draw);
	}

	function drawStill() {
		ctx.clearRect(0, 0, W, H);
		for (const s of stars) {
			ctx.beginPath();
			ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${TIERS[s.tier].color}, 0.45)`;
			ctx.fill();
		}
	}

	if (reducedMotion) {
		drawStill();
	} else {
		draw();
	}
</script>
